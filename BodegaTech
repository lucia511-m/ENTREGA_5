-- SECCION DDL 
DROP TABLE IF EXISTS Inventarios;--para eliminar tabla 
--CREAR TABLA INVENTARIOS 
CREATE TABLE Inventarios (
  IdProducto integer PRIMARY KEY AUTOINCREMENT,--identificador unico 
  Nombre_producto text (100) not null,--nombre del producto va con texto porque es nombre 
  Categoria text (50) not null,--categoria del producto 
  Precio_unitario decimal (10,2) not null,--precio de venta en USD  se elije decimal porque es moneda
  Stock_actual integer not null,--unidades disponibles se elije entero porque son unidades
  Stock_minimo integer not null,--umbral minimo de reposicion 
  Fecha_ingreso date,--fecha de ingreso al inventario 
  Activo integer (1)--1=disponible 0=discontinuado 
  );
  

